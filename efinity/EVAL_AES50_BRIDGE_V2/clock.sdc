
# PLL clock (Trion PLL from the 25 MHz input)
# CLK_100M / CLK_80M are still generated by the PLL but no longer used by the
# design; the whole eval top (IP, reset generator, CS2100 I2C) runs on CLK_50M.
##############################################
create_clock -period 20.00 CLK_50M

# external clocks
#################
# CS2100 audio PLL output, 1024 * fs (49.152 MHz)
create_clock -period 20.34 [get_ports {APLL_MCLK}]
# TDM bit clock read back from the pin, clocks the TDM serializer of the IP
# (12.288 MHz in TDM8 mode; I2S uses 3.072 MHz, so this is the worst case)
create_clock -period 81.38 [get_ports {TDM_BCLK_IN}]

# The IP domains only exchange data through dual-clock RAMs and toggle
# synchronizers.
set_clock_groups -asynchronous \
    -group {CLK_50M} \
    -group {APLL_MCLK} \
    -group {TDM_BCLK_IN}
